# --- MySQL admin (used ONLY by src/ingest_sql.py and the security setup script) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=supply_chain

# --- MySQL read-only agent account (created by scripts/setup_security_and_view.sql) ---
SQL_AGENT_USER=usr_fde_ro
SQL_AGENT_PASSWORD=

# --- LLM (cloud only): openai | anthropic | deepseek ---
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Vector DB + embeddings (same model/dimension as the ingestion endpoint) ---
PINECONE_API_KEY=
PINECONE_INDEX=cold-chain-sop
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Internal policy ingestion endpoint ---
INGEST_API_URL=
INGEST_API_KEY=

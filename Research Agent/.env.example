# ---- Which model to use. Nothing is built in: LLM_PROVIDER and LLM_MODEL are both required. ----
# anthropic | openai | gemini | deepseek
LLM_PROVIDER=
# The exact model id from your provider's docs
LLM_MODEL=

# API key for the provider you chose
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# ---- Optional model tuning ----
# Reasoning / thinking. Leave blank to use the model's own default.
#   deepseek : off | low | high | max     (V4 models think by default; "off" is the fast mode)
#   anthropic: off | low | medium | high | xhigh | max   (some models cannot turn thinking off)
#   openai   : off | minimal | low | medium | high | xhigh | max
#   gemini   : off | minimal | low | medium | high       (Gemini 2.5 uses a token budget: see LLM_EXTRA_PARAMS)
# Reasoning is much slower: on DeepSeek, off ~20s, low ~2 min, high ~3 min for 5 sources.
LLM_REASONING=
# A number, or "none" to not send it (some reasoning models reject temperature)
LLM_TEMPERATURE=0
# Output cap. Reasoning tokens count toward it. Blank = the provider's default (anthropic: 16000)
LLM_MAX_TOKENS=
# Anything else for the model class, as a JSON object, e.g. {"thinking_budget": 1024}
LLM_EXTRA_PARAMS=

# ---- App ----
# INFO = one line per node and LLM call; DEBUG = also full prompts and answers
LOG_LEVEL=INFO

# Re-render a page in headless Chromium when plain download yields too little text (JavaScript pages).
# Needs a one-time browser download: uv run playwright install chromium
# The Source status table shows which sources were browser-rendered.
USE_PLAYWRIGHT=true
# Browser load budget: wait up to BROWSER_TIMEOUT seconds for the page's DOM, then BROWSER_SETTLE seconds for scripts to fill it.
BROWSER_TIMEOUT=10
BROWSER_SETTLE=1.5
MAX_CHARS_PER_SOURCE=60000
CHUNK_CHARS=15000
GROUNDING_THRESHOLD=85

# anthropic | openai | gemini | deepseek
LLM_PROVIDER=anthropic
# Optional override; defaults per provider are in src/research_agent/llm.py
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Re-render pages with headless Chromium when static extraction yields too little text
# (requires: pip install -e ".[js]" && playwright install chromium)
# INFO = one line per node and LLM call; DEBUG = also full prompts and answers
LOG_LEVEL=INFO

USE_PLAYWRIGHT=false
MAX_CHARS_PER_SOURCE=60000
CHUNK_CHARS=15000
GROUNDING_THRESHOLD=85

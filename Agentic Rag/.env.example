# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - this file is the tracked template that documents
# what a new environment needs.

# Required only if you use the "pinecone" vector store (see README:
# "Vector stores"). Get a key at https://app.pinecone.io/.
PINECONE_API_KEY=

# Required only if hash_store_name / AGENTIC_RAG_API_HASH_STORE_NAME is set to
# "mysql" - lets many projects share one idempotency table instead of each
# getting its own local SQLite file. MYSQL_PORT defaults to 3306 if unset.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
